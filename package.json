{
  "name": "puck-todo-office",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev --local --port 8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply puck_todo_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply puck_todo_db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
