{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "puck-todo-office",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": [
      "ADMIN_EMAIL",
      "ADMIN_PASSWORD_HASH",
      "AUTH_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "puck_todo_db",
      "database_id": "__D1_DATABASE_ID__"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
